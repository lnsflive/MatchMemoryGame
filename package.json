{
  "name": "com.jaimegonzalez.memorygame2",
  "version": "0.0.1",
  "description": "A fun Memory Game",
  "productName": "Memory Game",
  "type": "module",
  "author": "Jaime Gonzalez <lnsflive@gmail.com>",
  "private": true,
  "scripts": {
    "webDebug": "quasar dev",
    "webBuild": "quasar build",
    "androidEmul": "quasar dev -m cordova -T android",
    "androidDebug": "quasar dev -m cordova -T android --ide",
    "build/androidIDE": "quasar build -m cordova -T android --ide",
    "buildIcons": "icongenie g -i ./src/assets/icon.png -b ./src/assets/bg.png",
    "test": "npm run typecheck && npm run test:unit",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --network host -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": ">= 22.12.0",
    "npm": ">= 10.0.0"
  }
}
